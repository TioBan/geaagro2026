# GeaAgro CRM - Environment Configuration Template
# Server & Port Configuration
PORT=3000
NODE_ENV=development

# Gemini API Integration (Server-Side Proxy)
GEMINI_API_KEY=

# Optional: Encryption passphrase for stored API keys
API_KEY_DECRYPTION_SECRET=agronutri-secure-encryption-passphrase-2026

# Development Flags
DISABLE_HMR=false
